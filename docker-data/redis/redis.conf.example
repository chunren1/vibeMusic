# ======================
# vibeMusic Redis 配置模板
# 复制此文件为 redis.conf 并配置密码：
#   cp docker-data/redis/redis.conf.example docker-data/redis/redis.conf
#
# 注意：Redis 配置文件不支持环境变量展开，requirepass 必须写入明文密码。
# 请把下方 <YOUR_REDIS_PASSWORD> 替换为你 .env 中 REDIS_PASSWORD 的实际值
# （docker-compose 的 healthcheck 与后端都会读取 .env 的 REDIS_PASSWORD，
#   两者必须一致，否则 Redis 认证失败）。
# ======================

# 绑定地址（Docker 内部通信）
bind 0.0.0.0

# 端口
port 6379

# 守护进程模式（Docker 内必须为 no）
daemonize no

# ===== 持久化 =====
# RDB 快照
save 900 1
save 300 10
save 60 10000

# RDB 文件名
dbfilename dump.rdb

# 工作目录
dir /data

# AOF 持久化（推荐开启）
appendonly yes
appendfilename "appendonly.aof"

# AOF 同步策略：每秒同步一次（性能与安全的平衡）
appendfsync everysec

# AOF 自动重写阈值
auto-aof-rewrite-percentage 100
auto-aof-rewrite-min-size 64mb

# ===== 内存 =====
# 必须严格小于「跑这个配置的那个栈」里 redis 的 mem_limit。
# 生产栈（docker-compose.demo.yml）mem_limit=128M → 这里取 96mb；
# 本地完整栈（docker-compose.yml）mem_limit=768M，可自行调到 512mb。
# 写大了不会「多给内存」——Redis 会在触发 LRU 淘汰之前先被 cgroup OOM kill，
# 然后重启、缓存全丢（表现为缓存莫名清空 + 容器重启次数增加）。
# 2026-10-26 对账：云上实际 96mb，仓库模板曾是 512mb（>128M，属必崩配置），已对齐；
# scripts/reconcile-cloud.sh 6b 节会持续盯住这条指令（整文件含密码，无法按 md5 比对）。
maxmemory 96mb
maxmemory-policy allkeys-lru

# ===== 日志 =====
loglevel notice
logfile ""

# ===== 安全 =====
# 明文密码：替换为与 .env 中 REDIS_PASSWORD 相同的值（Redis 不展开环境变量）
requirepass <YOUR_REDIS_PASSWORD>

# ===== 网络 =====
tcp-keepalive 300
timeout 300