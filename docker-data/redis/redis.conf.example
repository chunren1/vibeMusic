# ======================
# vibeMusic Redis 配置模板
# 复制此文件为 redis.conf 并配置密码：
#   cp docker-data/redis/redis.conf.example docker-data/redis/redis.conf
# 密码从环境变量 REDIS_PASSWORD 读取（docker-compose.yml 已注入），无需硬编码
# ======================

# 绑定地址（Docker 内部通信）
bind 0.0.0.0

# 端口
port 6379

# 守护进程模式（Docker 内必须为 no）
daemonize no

# ===== 持久化 =====
# RDB 快照
save 900 1
save 300 10
save 60 10000

# RDB 文件名
dbfilename dump.rdb

# 工作目录
dir /data

# AOF 持久化（推荐开启）
appendonly yes
appendfilename "appendonly.aof"

# AOF 同步策略：每秒同步一次（性能与安全的平衡）
appendfsync everysec

# AOF 自动重写阈值
auto-aof-rewrite-percentage 100
auto-aof-rewrite-min-size 64mb

# ===== 内存 =====
maxmemory 512mb
maxmemory-policy allkeys-lru

# ===== 日志 =====
loglevel notice
logfile ""

# ===== 安全 =====
# 密码由 .env 的 REDIS_PASSWORD 注入（保持与 compose/backend 一致）
requirepass ${REDIS_PASSWORD}

# ===== 网络 =====
tcp-keepalive 300
timeout 300