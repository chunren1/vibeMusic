# ==========================================
# vibeMusic 环境变量配置模板
# 复制此文件为 .env 并修改值：
#   cp .env.example .env
# 生成强密码: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# ⚠️ 以下变量在 docker-compose*.yml 中均为 fail-fast（${VAR:?…}，缺失即报错退出），
#    必须显式提供；仓库已彻底移除「缺了就猜 123456 / admin」的弱口令兜底（2026-10-19）。
# ==========================================

# ── MySQL（fail-fast，必填） ──
MYSQL_ROOT_PASSWORD=<your-strong-root-password>
DB_HOST=mysql
# 运行账号（只给 SELECT/INSERT/UPDATE/DELETE）——应用日常读写用这个
DB_USERNAME=vibemusic
DB_PASSWORD=<your-strong-db-password>
# Flyway 迁移账号（DML + DDL：CREATE/DROP/ALTER/INDEX/REFERENCES），只给 Flyway 用。
# 与运行账号分开的收益（2026-10-29 修正口径，别夸大）：
#   ① 防误操作：应用代码/手写 SQL 走运行连接，CREATE/ALTER/DROP 被 MySQL 直接拒（ERROR 1142）
#   ② 收窄 SQL 注入的 DDL 面：注入点一般复用运行账号的连接池，拿不到建表/删表能力
#   ③ 迁移失败不占运行账号：Flyway 的连接与锁和线上读写隔离
# ⚠️ 这**不是**「应用被攻破也改不了表结构」——FLYWAY_PASSWORD 通过 SPRING_FLYWAY_PASSWORD
#    注入后端同一个容器，RCE 后读 process.env 即可拿到迁移凭证。要做到那点必须把 Flyway
#    拆成独立 init job/容器（未实施，理由见 docs/2026-10-26-takeover-review.md §8.4）。
FLYWAY_USER=vibemusic_migrator
FLYWAY_PASSWORD=<your-strong-migrator-password>
# 备份账号（只读：SELECT / SHOW VIEW / TRIGGER / EVENT / LOCK TABLES）—— mysql-backup 容器用。
# 不再用 root 走 TCP：生产已 DROP root@'%'，`mysqldump -h mysql -u root` 会直接 1045。
# 只有 docker-compose.yml / docker-compose.full.yml 需要（云上 demo 栈不跑备份容器，可不填）。
BACKUP_PASSWORD=<your-strong-backup-password>

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<your-strong-redis-password>

# ── MinIO / RustFS ──
MINIO_ROOT_USER=rustfsadmin
MINIO_ROOT_PASSWORD=<your-strong-minio-password>
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=<your-strong-minio-password>
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=rustfsadmin
MINIO_SECRET_KEY=<your-strong-minio-password>
# 对象存储总开关：false=不部署 MinIO（云上常态，播放/下载走上游直连代理）
# 本地演示（完整栈含 MinIO）才设为 true
STORAGE_ENABLED=false

# ── JWT（fail-fast，必填） ──
JWT_SECRET=<generate-a-256-bit-random-secret>

# ── Cookie 加密（CookieCryptoService 启动硬性要求，缺失则 fail-fast 拒绝启动） ──
# 生成方法: openssl rand -base64 32
COOKIE_ENC_KEY=<generate-with-openssl-rand-base64-32>

# ── AI 助手（DeepSeek API Key） ──
AI_API_KEY=

# ── Grafana（docker-compose.yml / docker-compose.full.yml，fail-fast，必填） ──
GRAFANA_ADMIN_USER=<grafana-admin-user>
GRAFANA_ADMIN_PASSWORD=<change-me>

# ── 监控栈（monitoring/docker-compose.yml，独立 compose，fail-fast，必填） ──
# 需在 shell 环境或 monitoring/.env 中提供（该目录已 gitignore 掉 monitoring/.env）
GF_SECURITY_ADMIN_USER=<grafana-admin-user>
GF_SECURITY_ADMIN_PASSWORD=<change-me>

# ── musicapi ──
MUSICAPI_URL=http://musicapi:3000

# ── 音频流代理 CDN 白名单（逗号分隔，支持 *.xxx.com 通配符；须与 application.yml 默认值一致，含网易/QQ/咪咕/B站） ──
# STREAM_CDN_WHITELIST=*.music.126.net,*.gtimg.cn,*.stream.qqmusic.qq.com,*.tc.qq.com,*.tencentmusic.com,*.migu.cn,*.bilivideo.com,*.hdslb.com

# ── 音乐平台 Cookie（用于合法 API 访问） ──
# QQ音乐: 浏览器登录 y.qq.com → F12 → Application → Cookies → 复制各项到 JSON
MUSIC_QQ_COOKIE={"uin":"<你的QQ号>","qqmusic_key":"<key>","psrf_qqaccess_token":"<token>","psrf_qqopenid":"<openid>","psrf_qqrefresh_token":"<token>","psrf_qqunionid":"<unionid>","ptcz":"<ptcz>","qm_keyst":"<keyst>","tmeLoginType":"2"}
# 网易云: 浏览器登录 music.163.com → F12 → Application → Cookies → 复制完整 Cookie 字符串
MUSIC_NETEASE_COOKIE=<完整的网易云Cookie字符串>

# QQ 音乐源总开关（2026-10-27 起默认停用：会员到期后该源大量曲目不可播）
# false/0/off = 关闭：聚合搜索不再混入 QQ 结果，/source-health 里 qq 显示 disabled。
# 代码、端点、取链、歌词全部保留；充值后改回 true 重启 musicapi 即恢复，无需改代码。
MUSICAPI_QQ_ENABLED=false

# ── DB 连接池（Hikari） ──
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# ── OpenTelemetry / Tracing ──
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_PROBABILITY=0.1
OTEL_PROPAGATORS=tracecontext,baggage,b3
OTEL_JAVAAGENT_ENABLED=true
DEPLOYMENT_ENV=docker
PROJECT_VERSION=0.0.1

# ── 线程池（ThreadPoolConfig @ConfigurationProperties prefix=threadpool） ──
# 搜索线程池：高并发搜索聚合，建议 50/100/300
THREADPOOL_SEARCHCORE=50
THREADPOOL_SEARCHMAX=100
THREADPOOL_SEARCHQUEUE=300
THREADPOOL_SEARCHKEEPALIVE=60
# 预热线程池
THREADPOOL_WARMCORE=1
THREADPOOL_WARMMAX=1
THREADPOOL_WARMQUEUE=20
THREADPOOL_WARMKEEPALIVE=60
# 取播放链接线程池
THREADPOOL_GETURLCORE=3
THREADPOOL_GETURLMAX=3
THREADPOOL_GETURLQUEUE=10
THREADPOOL_GETURLKEEPALIVE=60

# ── Spring Profile ──
SPRING_PROFILES_ACTIVE=docker

# ── CORS 允许的来源（自动注入到 Spring Boot CorsConfig） ──
# 本地开发: http://localhost:5173
# 生产环境: https://your-domain.com
CORS_ORIGINS=https://localhost,http://localhost:5173,http://localhost:4173
