# ==========================================
# vibeMusic 环境变量配置模板
# 复制此文件为 .env 并修改值：
#   cp .env.example .env
# 生成强密码: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# ==========================================

# ── MySQL ──
MYSQL_ROOT_PASSWORD=<your-strong-root-password>
DB_HOST=mysql
DB_USERNAME=root
DB_PASSWORD=<your-strong-db-password>

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<your-strong-redis-password>

# ── Elasticsearch ──
ES_PASSWORD=<your-strong-es-password>
ES_URI=http://elastic:<your-strong-es-password>@elasticsearch:9200

# ── MinIO / RustFS ──
MINIO_ROOT_USER=rustfsadmin
MINIO_ROOT_PASSWORD=<your-strong-minio-password>
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=<your-strong-minio-password>
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=rustfsadmin
MINIO_SECRET_KEY=<your-strong-minio-password>

# ── JWT ──
JWT_SECRET=<generate-a-256-bit-random-secret>

# ── AI 助手（DeepSeek API Key） ──
AI_API_KEY=

# ── Grafana ──
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<change-me>

# ── musicapi ──
MUSICAPI_URL=http://musicapi:3000

# ── 音乐平台 Cookie（用于合法 API 访问） ──
# QQ音乐: 浏览器登录 y.qq.com → F12 → Application → Cookies → 复制各项到 JSON
MUSIC_QQ_COOKIE={"uin":"<你的QQ号>","qqmusic_key":"<key>","psrf_qqaccess_token":"<token>","psrf_qqopenid":"<openid>","psrf_qqrefresh_token":"<token>","psrf_qqunionid":"<unionid>","ptcz":"<ptcz>","qm_keyst":"<keyst>","tmeLoginType":"2"}
# 网易云: 浏览器登录 music.163.com → F12 → Application → Cookies → 复制完整 Cookie 字符串
MUSIC_NETEASE_COOKIE=<完整的网易云Cookie字符串>

# ── Spring Profile ──
SPRING_PROFILES_ACTIVE=docker

# ── CORS 允许的来源（自动注入到 Spring Boot CorsConfig） ──
# 本地开发: http://localhost:5173
# 生产环境: https://your-domain.com
CORS_ORIGINS=https://localhost,http://localhost:5173,http://localhost:4173
