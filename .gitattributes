# 统一行尾为 LF（Windows 开发者 checkout 时自动转 CRLF，提交时转 LF）
* text=auto eol=lf

# 二进制文件不转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary

# 特定文本文件类型
*.md text
*.java text
*.js text
*.ts text
*.vue text
*.json text
*.yml text
*.yaml text
*.xml text
*.sql text
*.sh text eol=lf
*.ps1 text
*.bat text
*.conf text
*.properties text
*.gradle text
*.html text
*.css text